# Feedify frontend — contoh .env
# Salin jadi frontend/.env lalu isi:   cp .env.example .env
# Semua variabel REACT_APP_* ikut tertanam di bundle browser, jadi jangan taruh rahasia apa pun di sini.
# Production (Vercel project feedify-ai) tidak membaca file ini — isi di Vercel → Settings → Environment Variables.
# Komentar harus di baris sendiri: dotenv versi CRA tidak mengenal komentar di belakang nilai.

# Alamat backend. Lokal: http://localhost:8001 (scripts/start-frontend.sh mengisinya otomatis pakai IP LAN)
REACT_APP_BACKEND_URL=http://localhost:8001

# Login Google — sama dengan GOOGLE_CLIENT_ID di backend
REACT_APP_GOOGLE_CLIENT_ID=

# Web push (Webpushr), dibaca oleh public/index.html
REACT_APP_WEBPUSHR_KEY=
