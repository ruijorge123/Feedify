# Feedify backend — contoh .env
# Salin jadi backend/.env lalu isi nilainya:   cp .env.example .env
# File ini ikut di git, jadi JANGAN pernah isi nilai asli di sini.
# Production (Vercel project feedify-server) tidak membaca .env — isi di Vercel → Settings → Environment Variables.
# Yang ditandai [WAJIB] harus diisi supaya server bisa jalan; sisanya opsional, fiturnya mati sendiri (503) kalau kosong.

# ── DATABASE ────────────────────────────────────────────────────
MONGO_URL=                      # [WAJIB] mongodb+srv://...
DB_NAME=feedify                 # [WAJIB]

# ── AUTH ────────────────────────────────────────────────────────
JWT_SECRET=                     # [WAJIB] string acak panjang
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168        # 7 hari
GOOGLE_CLIENT_ID=               # login Google; sama dengan REACT_APP_GOOGLE_CLIENT_ID di frontend
SUPER_ADMIN_EMAIL=              # admin yang boleh ubah role & hapus user; kosong = pakai default di server.py

# ── AI — TEKS (Groq) ────────────────────────────────────────────
# Anita (chat), Growth Consultant, caption. Semua key dirotasi otomatis kalau satu kena limit.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY=                   # dipakai hanya kalau GROQ_API_KEY_1..5 kosong semua
GROQ_MODEL=openai/gpt-oss-120b
GC_DAILY_LIMIT=3                # jatah sesi Growth Consultant per klien per hari

# ── AI — GAMBAR, VISION & VIDEO (tools produksi admin) ──────────
OPENAI_API_KEY=                 # gpt-image-1/2 + GPT-4o
FAL_KEY=                        # Reels (fal.ai Kling) + hapus background
HEYGEN_API_KEY=                 # Video Presenter / Talking Avatar

# ── EMAIL (OTP daftar + email aktivasi) ─────────────────────────
# Urutan dicoba: Resend → Brevo → SMTP. Cukup isi salah satu.
EMAIL_FROM=                     # contoh: Feedify <halo@feedifyid.com>
EMAIL_DOMAIN=
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── PEMBAYARAN (QRIS + approval lewat Telegram) ─────────────────
QRIS_IMAGE_PATH=/datapenting/qris2.jpeg   # gambar QR statis di frontend/public
QRIS_MERCHANT_NAME=Feedify
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=         # chat yang menerima bukti bayar + tombol Approve/Reject
TELEGRAM_GROUP_CHAT_ID=         # grup tim, dapat kabar saat data klien lengkap; kosong = default di server.py
TELEGRAM_WEBHOOK_SECRET=        # path rahasia untuk POST /api/telegram/webhook/{secret}
MANUAL_WHATSAPP_NUMBER=         # nomor WA Feedify format 62...; kosong = default di server.py
APP_BASE_URL=https://www.feedifyid.com   # dipakai untuk link di email aktivasi
# Sisa sistem transfer bank lama — masih dibaca kode, tidak tampil ke pembeli (QRIS saja)
MANUAL_BANK_NAME=BCA
MANUAL_BANK_ACCOUNT_NUMBER=
MANUAL_BANK_ACCOUNT_HOLDER=Feedify

# ── NOTIFIKASI (web push pengingat jadwal) ──────────────────────
WEBPUSHR_REST_API_KEY=
WEBPUSHR_AUTH_TOKEN=

# ── LAIN-LAIN ───────────────────────────────────────────────────
CORS_ORIGINS=*                  # pisahkan dengan koma untuk beberapa domain

# ── SISA LAMA (masih dibaca kode, fitur aktif tidak memakainya) ─
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=               # cadangan OPENAI_API_KEY dari platform Emergent
GROQ_API_KEY_LOCAL=
